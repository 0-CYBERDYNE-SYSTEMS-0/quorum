# Quorum — production environment (Docker Compose)
# Copy to .env.production. Compose reads this for Postgres credentials and the
# app container reads it for runtime secrets.

NODE_ENV=production
PORT=5001
ALLOWED_ORIGIN=https://your-domain.example

# Postgres (compose creates these on first boot)
POSTGRES_DB=quorum
POSTGRES_USER=quorum
POSTGRES_PASSWORD=change-this-long-random-string
# The app container gets DATABASE_URL rewritten to the internal db host.

# Runtime secrets
SESSION_SECRET=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
OPENROUTER_API_KEY=
DEFAULT_AUX_MODEL=
OPENROUTER_REASONING_EFFORT=
PRO_MONTHLY_AI_BUDGET_USD=4

# Optional local model routing
# LOCAL_AI_BASE_URL=http://ollama:11434/v1
# LOCAL_AI_MODEL=qwen3.8-27b

# Optional research retrieval
PERPLEXITY_API_KEY=

# Optional billing
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_WEBHOOK_SECRET=
VITE_ENTERPRISE_CONTACT_URL=
