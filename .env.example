# Quorum — environment
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5001
# Comma-separated list of hosts the app is served from. The same deployment
# can serve the Replit host AND a custom domain; checkout success/cancel URLs
# are built from the request origin only when it appears here.
# Example: https://quorum.desmond-digital.com,https://quorum-scrimwiggins.replit.app
ALLOWED_ORIGIN=http://localhost:5001

# PostgreSQL. Leave empty to run against in-memory storage (development only;
# everything is lost on restart).
DATABASE_URL=postgresql://localhost:5432/quorum_dev

# Session signing. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me

# House model key. Directors default to free-tier OpenRouter slugs; without a
# key, deliberation cannot run.
OPENROUTER_API_KEY=
# Optional reasoning effort for OpenRouter models that support it.
OPENROUTER_REASONING_EFFORT=
# Comma-separated OpenRouter providers to exclude from routing (default:
# Relace, which returned empty 200 streams). Set empty to allow all providers.
OPENROUTER_PROVIDER_IGNORE=Relace
# Monthly house-key AI budget per Pro (Executive) user in USD (default 8).
# When spent, directors keep running on the paid fallback model up to 25% over
# budget (hard ceiling), never on a free model. Bring-your-own-key calls do not
# count.
PRO_MONTHLY_AI_BUDGET_USD=8
# Monthly house-key AI budget per Boardroom user in USD (default 35).
BOARDROOM_MONTHLY_AI_BUDGET_USD=35
# Model for small planning calls (search planning). Defaults to a small paid
# slug on Pro/Boardroom, Enterprise and $5/$15 session credits. There is no
# free plan and no free model fallback.
TOOL_PLANNING_MODEL=
# Auxiliary calls: routing, insights, closing memo. Falls back to the first
# seated director's model when unset.
DEFAULT_AUX_MODEL=

# Encrypts user-supplied API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Local AI (optional) — route director calls to an OpenAI-compatible endpoint.
# LOCAL_AI_BASE_URL=http://127.0.0.1:8081/v1
# LOCAL_AI_MODEL=qwen3.8-27b
# LOCAL_AI_API_KEY=

# Research retrieval for the Market Research Analyst (optional).
PERPLEXITY_API_KEY=

# Stripe (optional). Without these, new accounts have no plan (they may still
# buy a session once billing is configured) and billing fails closed readably. Price amounts are
# display-only in shared/pricing.ts; Stripe price ids ALWAYS come from here.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
# Pro (Executive): $29/month recurring.
STRIPE_PRICE_ID_PRO=
# Pro (Executive): $290/year recurring.
STRIPE_PRICE_ID_PRO_ANNUAL=
# Boardroom: $99/month recurring.
STRIPE_PRICE_ID_BOARDROOM=
# Boardroom: $990/year recurring.
STRIPE_PRICE_ID_BOARDROOM_ANNUAL=
# One-time Single Session credit ($5, up to 5 directors, fast models).
STRIPE_PRICE_ID_SESSION_FAST=
# One-time Boardroom Session credit ($15, up to 8 directors, frontier models).
STRIPE_PRICE_ID_SESSION_BOARDROOM=
# Deprecated: STRIPE_PRICE_ID (legacy /api/create-subscription fallback only).
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional enterprise contact link (mailto: or scheduling URL).
VITE_ENTERPRISE_CONTACT_URL=
